# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# runtime inventory (seed lives in lib/ + data/positions.seed.json)
# The durable catalog is written to the git branch `catalog` via the GitHub API.
# A local copy is encrypted and must not land on main by accident.
/data/store.json
/data/catalog.json
/data/catalog.json.tmp
/data/*-backup.json
/data/blob-latest.json
/public/uploads

# local agent scratch
/agent-tools

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
