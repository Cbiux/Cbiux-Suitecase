# Public site URL (used for OG metadata)
NEXT_PUBLIC_SITE_URL=https://cbiux-suitcase.vercel.app

# SINPE Móvil (Costa Rica). Default hardcoded: 84358038
NEXT_PUBLIC_SINPE_PHONE=84358038

# EVM / Base USDC receive address. Default hardcoded below.
NEXT_PUBLIC_USDC_BASE_ADDRESS=0xC38555a1Afcd8394532Caa11D0be60Df166eC188

# Stellar USDC receive address. Default hardcoded below.
NEXT_PUBLIC_USDC_STELLAR_ADDRESS=GAS52QOWKVBW2WYDRQ3KS4CSJ2QQNALPGURK2HLGJSNE2XUH7BH555BS

# Optional Solana USDC address. Leave empty if you do not have one.
NEXT_PUBLIC_USDC_SOLANA_ADDRESS=

# Password for /admin.
ADMIN_PASSWORD=123Cbiux@#$

# Neon Postgres — required on Vercel so reservations reach /admin.
# Create a free DB at https://console.neon.tech and paste the URI here.
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional Upstash Redis (legacy fallback if DATABASE_URL is missing).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# stub (default) accepts a valid-looking tx hash after reservation.
# indexer fails closed until you wire a real explorer — see lib/payments.ts
# SINPE is always confirmed by hand in /admin.
PAYMENT_VERIFY_MODE=stub

# Optional Helio paylink
# NEXT_PUBLIC_HELIO_PAY_URL=https://app.hel.io/pay/...

# Optional override for the JSON store path (ignored when DATABASE_URL is set)
# STORE_PATH=/tmp/cbiux-store.json
